# SHP Outbound Agent — environment variables
# Copy the ones you need into Vercel → Project → Settings → Environment Variables.
# Vite VITE_* vars are inlined at BUILD time; everything else is read at runtime
# by the serverless functions. After changing any var in Vercel, REDEPLOY.

# ─── Core APIs (required for the named feature) ──────────────────────────────
ANTHROPIC_API_KEY=          # Anthropic Messages API — research, drafting, scrape extraction
APOLLO_API_KEY=             # Apollo — enrich (1 credit/match) + people/org search
PIPEDRIVE_API_TOKEN=        # Pipedrive personal API token — CRM push
PIPEDRIVE_DOMAIN=           # optional, e.g. superiorhardware.pipedrive.com

# ─── Vercel KV / Upstash Redis ───────────────────────────────────────────────
# Required for M365 token storage, open-tracking pixels, and bounce records.
# Without these, sender-identity/settings fall back to localStorage and the
# tracking/bounce features are unavailable.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Microsoft 365 send + bounce tracking (Azure App Registration) ───────────
MS_CLIENT_ID=               # Azure App Registration → Application (client) ID
MS_TENANT_ID=               # Azure App Registration → Directory (tenant) ID
MS_CLIENT_SECRET=           # Azure → Certificates & secrets → the VALUE (not the Secret ID)
APP_URL=                    # deployment base URL, e.g. https://shp-agent.vercel.app
                            # set explicitly so OAuth redirect + pixel URLs don't rely
                            # on a spoofable x-forwarded-host header
PIXEL_BASE_URL=             # optional — same-root-domain pixel host for deliverability,
                            # e.g. https://track.superiorhardwareproducts.com

# ─── App-key gate for browser-facing endpoints ──────────────────────────────
# Gates /api/anthropic, /api/apollo, /api/opens, and /api/import-prospect GET
# against drive-by abuse. SET BOTH TO THE SAME VALUE. If unset, the gate is
# DORMANT (app works, endpoints open). Generate with: openssl rand -hex 32
SHP_API_KEY=                # runtime — checked by the serverless functions
VITE_SHP_API_KEY=           # build — same value; the SPA sends it as X-SHP-Key
# NOTE: VITE_SHP_API_KEY ships in the JS bundle, so it is a speed-bump, not a
# secret. Pair it with an Anthropic monthly spend cap (console.anthropic.com)
# as the real billing backstop.

# ─── ICP Scout integration (only if used) ───────────────────────────────────
INTERNAL_API_KEY=           # shared secret for /api/import-prospect POST.
                            # MUST match the value set on the ICP Scout side.
                            # The endpoint returns 500 if this is unset.

# ─── Optional hardening ──────────────────────────────────────────────────────
# When set, require X-Shp-Secret on the respective endpoint. Safe to leave
# unset in a single-tenant deployment.
SCRAPE_SECRET=              # /api/scrape-url
BOUNCE_CHECK_SECRET=        # /api/ms-send?action=check-bounces
